<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.company</groupId>
    <artifactId>retail-finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>retail-infrastructure</artifactId>
  <name>Retail Finance :: Infrastructure</name>
  <description>基础设施层：outbox 发布/消费机制、营业日历、Flyway 迁移脚本 V1–V17（唯一目录）</description>

  <dependencies>
    <!-- 持久层：MyBatis（SqlSessionFactory 由 starter 按各服务 DataSource 自动装配） -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>retail-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- OutboxPublisher 契约与事件守卫在 common（infrastructure → common → domain，无环） -->
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>retail-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- MQ：RocketMQ 客户端（ADR-RF-014）。生产端/消费端在 infrastructure/messaging，
         生命周期自管；仅引用客户端，不引 Spring Boot Starter（避免自动装配与精确装配冲突）。 -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
    </dependency>
    <!-- Flyway：只有 retail-core 开启（spring.flyway.enabled=true），其余服务 false。
         Flyway 9.x（Boot 3.2.5 纳管 9.22.3）的 PostgreSQL 支持内置于 flyway-core，无需单独模块 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
