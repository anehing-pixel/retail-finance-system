<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.company</groupId>
    <artifactId>retail-finance-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>retail-recon-service</artifactId>
  <name>Retail Finance :: recon-service</name>
  <description>INV-1~5 对拍与差异</description>

  <dependencies>
    <!-- 共用 Web/鉴权基础设施 + 应用/基础设施层（精确装配，不扫全包） -->
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>retail-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>retail-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.company</groupId>
      <artifactId>retail-infrastructure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 服务注册发现；本地无 Nacos 时 fail-fast=false，路由用 ROUTE_* 直连覆盖 -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.company.retail.recon.ReconServiceApplication</mainClass>
        </configuration>
        <!-- 自定义 parent（非 spring-boot-starter-parent）需显式绑定 repackage -->
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
